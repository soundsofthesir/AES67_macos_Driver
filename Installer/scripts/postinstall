#!/bin/bash
#
# postinstall
# AES67 macOS Driver Installer - runs after the package is installed.
#
LOG_FILE="/tmp/aes67driver_install.log"
export LOG_FILE
echo "=== AES67 Driver Post-Installation Script ===" | tee -a "$LOG_FILE"
echo "Date: $(date)" | tee -a "$LOG_FILE"

"$(dirname "$0")/configure-driver" || exit 1

cat <<'DONE' | tee -a "$LOG_FILE"

The driver is installed as "AES67 Device". To send this Mac's audio to an
AES67 stream:

  aes67ctl doctor --interface <interface>
  sudo aes67ctl setup --interface <interface> --send <multicast group>

DONE
exit 0
